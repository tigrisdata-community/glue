package main

templ Base(title string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<style>{ siteCSS }</style>
		</head>
		<body>
			<main>
				@content
			</main>
		</body>
	</html>
}

templ PageView(title string, bodyHTML string) {
	<article>
		@templ.Raw(bodyHTML)
	</article>
}
